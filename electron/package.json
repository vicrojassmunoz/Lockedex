{
  "name": "lockedex",
  "productName": "Lockedex",
  "version": "1.28.0",
  "description": "Lockedex: tracker de Nuzlocke para escritorio, con las partidas guardadas en un archivo local",
  "author": "Lockedex",
  "license": "BSD-3-Clause",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64",
    "publicar:win": "electron-builder --win nsis --x64 --publish always"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "app.lockedex",
    "productName": "Lockedex",
    "asar": false,
    "files": [
      "main.mjs",
      "preload.cjs",
      "icono.png",
      "package.json",
      "LICENSE.txt",
      "app/**/*",
      "!app/**/*.map",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "icon": "icono.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lockedex",
      "artifactName": "Lockedex-Instalador-${version}.exe",
      "language": "3082",
      "installerLanguages": [
        "es_ES"
      ],
      "deleteAppDataOnUninstall": false,
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "vicrojassmunoz",
        "repo": "Lockedex",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "repository": "https://github.com/vicrojassmunoz/Lockedex"
}
